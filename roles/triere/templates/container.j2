# THIS FILE MANAGED BY ANSIBLE
[Unit]
Description={{ _tcm.description | d(_tpm.metadata.description) }}
{% if  _tcm.iniSections.unit is defined %}
{%  with _i =  _tcm.iniSections.unit %}
{%    include 'includes/1.j2' %}
{%  endwith %}
{% endif %}

[Container]
Pod={{ _tpm.metadata.name }}.pod
Image={{ _tcm.image }}
ContainerName={{ _tpm.metadata.name }}-{{ _tcm.name }}
ServiceName=container-{{ _tpm.metadata.name }}-{{ _tcm.name }}
{% if _tcm.env is defined %}
{%  for key, value in _tcm.env | dictsort %}
Environment={{ key }}={{ value }}
{%  endfor %}
{% endif %}
{% for _file in _tcm.envFile | d([]) %}
EnvironmentFile={{ _triere_pod_cfg_dir }}/{{ _file }}.env"
{% endfor %}
{% if _tcm.volumes is defined %}
{%  for _path in _tcm.volumes.hostPath | d([]) %}
Volume={{ _path.path }}:{{ _path.mount }}{{ (_path.options is defined) | ternary(':' ~ _path.options | d(None), None) }}
{%  endfor %}
{%  for _vol in _tcm.volumes.podmanVolume | d([]) %}
Volume={{ _vol.name }}:{{ _vol.mount }}{{ (_vol.options is defined) | ternary(':' ~ _vol.options | d(None), None) }}
{%  endfor %}
{% endif %}
{% if  _tcm.iniSections.container is defined %}
{%  with _i =  _tcm.iniSections.container %}
{%    include 'includes/1.j2' %}
{%  endwith %}
{% endif %}
{% if  _tcm.iniSections.service is defined %}

[Service]
{%  with _i =  _tcm.iniSections.service %}
{%    include 'includes/1.j2' %}
{%  endwith %}
{% endif %}

[Install]
WantedBy=default.target
