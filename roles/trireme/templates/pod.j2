# THIS FILE MANAGED BY ANSIBLE
[Unit]
Description={{ _tpm.metadata.description }}
{% if  _tpm.spec.iniSections.unit is defined %}
{%  with _i =  _tpm.spec.iniSections.unit %}
{%    include 'includes/1.j2' %}
{%  endwith %}
{% endif %}

[Pod]
ServiceName=pod-{{ _tpm.metadata.name }}
{% if  _tpm.spec.publishPort is defined %}
{%  with _port = _tpm.spec.publishPort %}
{%    if _port | type_debug == 'list' %}
{%	for item in _port %}
PublishPort={{ item }}
{%	endfor %}
{%    else %}
PublishPort={{ _port }}
{%    endif %}
{%  endwith %}
{% endif %}
{% if  _tpm.spec.iniSections.pod is defined %}
{%  with _i =  _tpm.spec.iniSections.pod %}
{%    include 'includes/1.j2' %}
{%  endwith %}
{% endif %}
PodmanArgs=--exit-policy=continue
{% if  _tpm.spec.iniSections.service is defined %}

[Service]
{%  with _i =  _tpm.spec.iniSections.service %}
{%    include 'includes/1.j2' %}
{%  endwith %}
{% endif %}

[Install]
WantedBy=default.target
